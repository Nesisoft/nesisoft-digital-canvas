# Copy to `.env` and adjust. The defaults work for a local MongoDB.

# --- Server ---
PORT=5000

# Comma-separated list of origins allowed to call the public API.
# In dev the Vite app runs on http://localhost:8080.
CORS_ORIGIN=http://localhost:8080,http://localhost:5173

# --- Database ---
MONGODB_URI=mongodb://127.0.0.1:27017/nesisoft

# --- Admin auth ---
# Hardcoded fallbacks live in src/auth.js; these env vars override them once set.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
SESSION_SECRET=replace-with-a-long-random-string
