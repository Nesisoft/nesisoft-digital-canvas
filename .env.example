# Copy to `.env.local` and fill in. All client-exposed vars must be prefixed VITE_.

# Contact form + blog newsletter signup delivery — free key tied to your inbox at
# https://web3forms.com. Without this, the contact form falls back to opening the
# visitor's mail client and the newsletter signup is hidden.
VITE_WEB3FORMS_ACCESS_KEY=

# Privacy-friendly analytics — your site domain as registered at plausible.io
# Leave blank to disable analytics entirely.
VITE_PLAUSIBLE_DOMAIN=

# Groq API key for the AI Blog Studio at /studio (get one at https://console.groq.com).
# DEV ONLY: this is used only during `npm run dev` and must NOT be set for
# production builds, since VITE_ vars are embedded in the client bundle.
VITE_GROQ_API_KEY=

# --- Monolith API ---
# These are server-only vars (never prefix them with VITE_). Set them in Vercel
# project settings, and here for running the API locally.
PORT=5050
# PostgreSQL connection string. Supabase: Connect (top of the dashboard). On Vercel
# use the "Transaction pooler" string (host aws-...pooler.supabase.com, port 6543,
# user postgres.<project-ref>): Vercel is IPv4-only and the "Direct connection"
# host (db.<project-ref>.supabase.co) is IPv6-only. For local dev and
# `npm run db:migrate` the "Session pooler" string (port 5432) works too.
# Percent-encode @ # / ? in the password.
DATABASE_URL=
# Recommended in production: Supabase's CA certificate (PEM, Database Settings > SSL)
# so the database TLS certificate is verified.
# DATABASE_CA_CERT=
# Supabase Storage for images uploaded in /admin (Project Settings > API).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=site-images
# Production deploys on Vercel migrate the database (and fill a new one with the
# site's built-in content, once) after building. Set to false to skip that.
# MIGRATE_ON_DEPLOY=false
# Admin login. Local dev falls back to admin / changeme. In production
# (NODE_ENV=production or on Vercel) /admin sign-in stays disabled until the
# username, a password (ADMIN_PASSWORD or ADMIN_PASSWORD_HASH below) and the
# secret are all set — the placeholder password and secret below are refused.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
# Better: store a hash instead of the raw password. Run `npm run hash-password`
# and paste the ADMIN_PASSWORD_HASH=scrypt$... line it prints; it takes
# precedence over ADMIN_PASSWORD (remove that one). Failed sign-ins are rate
# limited: 5 per IP and 50 overall per 15 minutes.
# ADMIN_PASSWORD_HASH=
SESSION_SECRET=replace-with-a-long-random-string
CORS_ORIGIN=http://localhost:8080,http://localhost:5173
