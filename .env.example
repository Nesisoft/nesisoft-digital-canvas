# Copy to `.env.local` and fill in. All client-exposed vars must be prefixed VITE_.

# Contact form delivery — free key tied to your inbox at https://web3forms.com
# Without this, the form falls back to opening the visitor's mail client.
VITE_WEB3FORMS_ACCESS_KEY=

# Privacy-friendly analytics — your site domain as registered at plausible.io
# Leave blank to disable analytics entirely.
VITE_PLAUSIBLE_DOMAIN=

# Groq API key for the AI Blog Studio at /studio (get one at https://console.groq.com).
# DEV ONLY: this is used only during `npm run dev` and must NOT be set for
# production builds, since VITE_ vars are embedded in the client bundle.
VITE_GROQ_API_KEY=

# --- Monolith API ---
# These are server-only vars. Set them in Vercel project settings and in a local
# .env file when running the API locally.
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/nesisoft
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
SESSION_SECRET=replace-with-a-long-random-string
CORS_ORIGIN=http://localhost:8080,http://localhost:5173
