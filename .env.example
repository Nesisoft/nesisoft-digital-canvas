# Copy to `.env.local` and fill in. All client-exposed vars must be prefixed VITE_.

# Blog newsletter signup delivery — free key tied to your inbox at
# https://web3forms.com. Without this, the newsletter signup is hidden. (The
# contact form posts to the site's own API; see the SMTP settings below.)
VITE_WEB3FORMS_ACCESS_KEY=

# Privacy-friendly analytics — your site domain as registered at plausible.io
# Leave blank to disable analytics entirely.
VITE_PLAUSIBLE_DOMAIN=

# Groq API key for the AI Blog Studio at /studio (get one at https://console.groq.com).
# DEV ONLY: this is used only during `npm run dev` and must NOT be set for
# production builds, since VITE_ vars are embedded in the client bundle.
VITE_GROQ_API_KEY=

# --- Monolith API ---
# These are server-only vars (never prefix them with VITE_). Set them in Vercel
# project settings, and here for running the API locally.
PORT=5050
# PostgreSQL connection string. Supabase: Connect (top of the dashboard). On Vercel
# use the "Transaction pooler" string (host aws-...pooler.supabase.com, port 6543,
# user postgres.<project-ref>): Vercel is IPv4-only and the "Direct connection"
# host (db.<project-ref>.supabase.co) is IPv6-only. For local dev and
# `npm run db:migrate` the "Session pooler" string (port 5432) works too.
# Percent-encode % @ # / ? in the password (e.g. with encodeURIComponent).
DATABASE_URL=
# Recommended in production: Supabase's CA certificate (PEM, Database Settings > SSL)
# so the database TLS certificate is verified.
# DATABASE_CA_CERT=
# Supabase Storage for images uploaded in /admin (Project Settings > API).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=site-images
# Private bucket for briefs attached to the contact form (created alongside).
# SUPABASE_DOCUMENTS_BUCKET=inquiry-files
# Email, through the company mailbox's SMTP server (Hostinger by default): new
# contact-form inquiries are emailed to INQUIRY_NOTIFY_EMAIL, and replies are
# sent from /admin. Without SMTP_USER/SMTP_PASSWORD, inquiries are still saved
# in /admin but nobody is emailed and replying from /admin is off.
SMTP_USER=
SMTP_PASSWORD=
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# MAIL_FROM="Nesisoft" <info@nesisoft.com>
INQUIRY_NOTIFY_EMAIL=
# Links in emails point here.
# SITE_URL=https://www.nesisoft.com
# Production deploys on Vercel migrate the database (and fill a new one with the
# site's built-in content, once) after building. Set to false to skip that.
# MIGRATE_ON_DEPLOY=false
# Admin accounts live in the database (users table). These create the first
# super admin: while there's no active super admin, signing in to /admin with
# this email and password creates one (or restores it) and asks it to choose a
# new password. After that they're ignored, so ADMIN_PASSWORD can be removed.
# Local dev falls back to admin / changeme; production refuses the placeholder.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
# Or store a hash instead of the raw password: run `npm run hash-password` and
# paste the ADMIN_PASSWORD_HASH=scrypt$... line it prints (it takes precedence).
# ADMIN_PASSWORD_HASH=
# Signs admin sessions. In production (NODE_ENV=production or on Vercel) /admin
# sign-in stays disabled until this is a real value. Failed sign-ins are rate
# limited: 5 per IP and 50 overall per 15 minutes.
SESSION_SECRET=replace-with-a-long-random-string
CORS_ORIGIN=http://localhost:8080,http://localhost:5173
