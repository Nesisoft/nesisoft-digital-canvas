{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/admin", "destination": "/200.html" },
    { "source": "/admin/:path*", "destination": "/200.html" },
    { "source": "/((?!api/|assets/|.*\\..*).*)", "destination": "/200.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
